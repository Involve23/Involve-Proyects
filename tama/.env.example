# Copia este archivo como .env y completa lo que necesites. .env nunca se sube a git.

# Clave de la API de Anthropic. Sin ella, la captura funciona, pero una pregunta a la vez (sin interpretación con Claude).
ANTHROPIC_API_KEY=

# Modelo que interpreta lo que escribes. Cámbialo si tu cuenta usa otro.
CLAUDE_MODEL=claude-sonnet-5-5

# Quién eres en localhost (aparece como autor de cada dato).
USUARIO_ID=local
USUARIO_NOMBRE=Brayan

# IA sin costo y sin salir de tu computadora: un modelo local con Ollama o LM Studio.
# Con IA_PROVEEDOR=local se ignora la clave de Anthropic. Ollama: instala y corre «ollama pull qwen2.5:14b».
# LM Studio: activa su servidor local y usa IA_LOCAL_URL=http://127.0.0.1:1234/v1/chat/completions
# IA_PROVEEDOR=local
# IA_LOCAL_MODELO=qwen2.5:14b
# IA_LOCAL_URL=http://127.0.0.1:11434/v1/chat/completions

# Puerto del servidor local. Solo escucha en 127.0.0.1 para no exponer tu clave.
PUERTO=3000
